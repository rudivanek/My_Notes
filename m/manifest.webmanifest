{
  "id": "./",
  "name": "My Notes Mobile",
  "short_name": "My Notes",
  "description": "My Notes on your phone: read, search, capture and edit the notes in your Dropbox notes folder.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAF9F6",
  "theme_color": "#FAF9F6",
  "icons": [
    { "src": "../icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "../icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "../icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./?share=1",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "New note", "short_name": "New", "url": "./?do=new", "icons": [{ "src": "../icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Search notes", "short_name": "Search", "url": "./?do=search", "icons": [{ "src": "../icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
