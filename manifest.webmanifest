{
  "name": "My Notes",
  "short_name": "My Notes",
  "description": "A calm editor for your notes folder. Your notes stay on your computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAF9F6",
  "theme_color": "#B4532A",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "description": "Start a new note right away",
      "url": "./?do=new",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today's note",
      "short_name": "Today",
      "description": "Open today's daily note",
      "url": "./?do=daily",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search notes",
      "short_name": "Search",
      "description": "Search all your notes",
      "url": "./?do=search",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
